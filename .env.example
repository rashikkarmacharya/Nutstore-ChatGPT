# Nutstore WebDAV credentials. Use a Nutstore third-party application password,
# not your normal Nutstore sign-in password.
NUTSTORE_USERNAME=
NUTSTORE_APP_PASSWORD=
NUTSTORE_WEBDAV_URL=https://dav.jianguoyun.com/dav/

# Long random secret used as a Bearer token for both API and MCP requests.
NUTSTORE_API_TOKEN=
